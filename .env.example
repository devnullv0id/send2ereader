# send2ereader configuration.
#
#   cp .env.example .env
#
# Every setting is optional. With no .env at all the app comes up working, and
# the first account created becomes the administrator. Uncomment what you want.
#
# Real environment variables win over this file, so `docker run -e ...` and
# compose `environment:` entries override anything set here.
#
# Values must NOT be quoted: `docker run --env-file` takes quotes literally and
# would include them in the value. compose.yaml.example is the opposite — YAML
# needs its values quoted — and lists all of these too.
#
# Most of what is here can also be set from the admin page, which stores it in
# the database and beats this file; Reset on the field gives this file back. The
# sections marked "environment only" cannot: they decide how the process starts,
# so the page shows them read-only and they take a restart.


# ── The address people reach this server on ──────────────────────────────
# Every link, every paired Kobo and every passkey is bound to it.
# PROTOCOL=http
# DOMAIN=books.example.com       # a name, not an IP: no browser holds a passkey for an address
# TRUST_PROXY=false              # behind a proxy, name it: 192.168.20.2


# ── Language ─────────────────────────────────────────────────────────────
# The default until a visitor picks their own. Installed codes come from the
# files in languages/ and /data/languages; changeable from the admin page.
# LANGUAGE=en


# ── Accounts ─────────────────────────────────────────────────────────────
# ALLOW_SIGNUP=false             # off, only the first account can be made
# ALLOW_STAY_SIGNED_IN=true      # off, every session ends with the browser
# SESSION_TTL=2592000            # 30 days, idle: renewed every time it is used
# SIGNIN_LINK_TTL=900            # 15 minutes; the link *is* the credential
# EMAIL_TOKEN_TTL=86400          # 24 hours, confirmation and reset links
# VERIFY_REMINDER_LIMIT=5        # "not now" answers allowed; 0 asks once


# ── Passwords ────────────────────────────────────────────────────────────
# Length does more than any composition rule, which is why the rest start off.
# MIN_PASSWORD_LENGTH=10
# MAX_PASSWORD_LENGTH=1024
# PASSWORD_REQUIRE_UPPER=false
# PASSWORD_REQUIRE_LOWER=false
# PASSWORD_REQUIRE_DIGIT=false
# PASSWORD_REQUIRE_SYMBOL=false


# ── Failed sign-ins ──────────────────────────────────────────────────────
# Nothing is ever locked; the address is sent a notice and pointed at a reset.
# FAILED_SIGNINS_BEFORE_ALERT=5  # above 9 is never reached: 10 tries per 5 min
# FAILED_SIGNIN_WINDOW=900       # a slower run than this is not a run
# FAILED_SIGNIN_ALERT_EVERY=3600 # one notice per account per hour


# ── Mail ─────────────────────────────────────────────────────────────────
# Off, confirmation and reset links go to the log instead — with their tokens
# redacted. MAIL_LOG_SECRETS=true makes them usable:
#   docker logs send2ereader | grep /auth/verify
# SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls         # starttls (587, 25) | ssl (465) | none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=               # falls back to SMTP_USERNAME if that is an address
# SMTP_FROM_NAME=send2ereader
# SMTP_TIMEOUT_SECONDS=30
# MAIL_LOG_SECRETS=false         # a link in a log is a live credential
# SMTP_TLS=true                  # environment only; SMTP_SECURITY replaces it


# ── Single sign-on ───────────────────────────────────────────────────────
# Needs DOMAIN: the provider redirects to <PROTOCOL>://<DOMAIN>/auth/sso/callback.
# OIDC_ENABLED=false
# OIDC_PROVIDER_NAME=SSO         # the button reads "Continue with —"
# OIDC_CONFIG_URL=https://your-idp/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ADMIN_GROUP=              # empty, SSO never grants admin


# ── Sending ──────────────────────────────────────────────────────────────
# KEY_LENGTH=4                   # a key lives for minutes, so four is enough
# MAX_FILE_SIZE=838860800        # 800 MB
# EXPIRE_SECONDS=300             # a key lives this plus a short silent-poll allowance
# MAX_EXPIRE_SECONDS=600         # hard ceiling from minting, never extended
# EREADER_POLL_SECONDS=2         # lower is snappier and noisier


# ── Converting ───────────────────────────────────────────────────────────
# LAYOUT_FIX_DEFAULT=true        # how the option starts on Send and Convert
# KINDLE_SHARE_NOT_SYNC=true     # off, a Kindle refuses the cover inside the file
# CALIBRE_OUTPUT_PROFILE=kindle_pw3   # empty omits --output-profile
# CONVERSION_TIMEOUT_MS=600000   # too low turns slow books into failed ones
# CONVERSION_CONCURRENCY=2       # past the core count they queue anyway
# CONVERSION_OUTPUT_LIMIT=65536  # converter output kept for the error message
# CONVERT_TTL=1800               # backstop for a conversion nobody downloaded


# ── Library ──────────────────────────────────────────────────────────────
# Everything else is an outbox. This is the only store that survives a restart.
# RETAIN_DAYS=0                  # 0 keeps nothing; above 0 is default and ceiling
# STORAGE_PER_USER=1073741824    # 1 GiB per account
# STORAGE_TOTAL=10737418240      # 10 GiB across the library


# ── Kobo sync ────────────────────────────────────────────────────────────
# A registered Kobo pulls books into its own library. Needs accounts and DOMAIN.
# KOBO_QUEUE_TTL=21600           # 6 hours; a Kobo may not sync for a while
# KOBO_STORE_URL=https://storeapi.kobo.com          # what this server does not answer
# KOBO_IMAGE_BASE_URL=https://cdn.kobo.com/book-images
# KOBO_PROXY_TIMEOUT_MS=10000    # a store outage must not hang the device
# KOBO_PROXY_BODY_LIMIT=1048576


# ── Server, environment only ─────────────────────────────────────────────
# Where the process listens, which never appears in a link.
# HTTP_ADDR=0.0.0.0
# HTTP_PORT=3001                 # in the container; the port mapping decides the outside


# ── Storage, environment only ────────────────────────────────────────────
# The image sets these under /data; moving one means moving the mount.
# STATIC_DIR alone is relative, to where the server was started.
# DATA_DIR=/data
# DB_PATH=/data/db/send2ereader.db    # the session key sits beside it; outside the image: data/send2ereader.db
# UPLOAD_DIR=/data/uploads       # where a book waits; nothing here survives
# LIBRARY_DIR=/data/library
# KOBO_QUEUE_DIR=/data/queue
# STATIC_DIR=static
# CLEAN_UPLOAD_DIR_ON_BOOT=true  # keys die with a restart, so leftovers are unreachable
# ENV_FILE=                      # load a different file; read before any file is


# ── Logging, environment only ────────────────────────────────────────────
# LOG_LEVEL=info                 # trace|debug|info|warn|error|fatal|silent
# LOG_FORMAT=text                # text to read, json for a log collector
# LOG_TIME=iso                   # iso|short|rel|none
# LOG_SCOPE=                     # comma separated, -name excludes, empty is all
# LOG_PRETTY=true                # the older spelling: off means JSON. LOG_FORMAT wins
# NO_COLOR=                      # set to anything and colour is off; no-color.org


# ── Converters, environment only ─────────────────────────────────────────
# Binary names, only needed if they are not on PATH under these.
# KEPUBIFY_BIN=kepubify
# EBOOK_CONVERT_BIN=ebook-convert
# PDFCROPMARGINS_BIN=pdfcropmargins
# CALIBRE_CUSTOMIZE_BIN=calibre-customize
# EPUB_LAYOUT_FIX_BIN=epub-layout-fix
# EPUB_LAYOUT_FIX_LIB=/opt/epub-layout-fix   # read by the wrapper, not by this server
# CONVERT_RATE_MAX=5             # conversions per client address per window
# CONVERT_RATE_WINDOW=1 minute


# ── Extensions, environment only ─────────────────────────────────────────
# Too big to ship, or not ours to redistribute, so the image fetches them:
# queued at start to a background agent, and the server answers while they
# download. Pipe separated, read by the script that starts the server.
# EXTENSIONS=calibre|pdfcrop|kfx
# EXTENSION_PACKAGES=fonts-noto-cjk|poppler-utils    # apt, on every start
# KFX_PREVIEWER_PATH=            # only if the Previewer came from elsewhere


# ── The container itself ─────────────────────────────────────────────────
# PUID=1000                      # the user files under /data are written as
# PGID=1000


# ── Security, environment only ───────────────────────────────────────────
# ACCOUNTS=true                  # off removes sign-in, the library and the admin page
# SESSION_SECRET=                # unset, one is generated beside the database
# SCRYPT_N=65536                 # ~130ms and 64MB per attempt; stored hashes keep theirs
# LOCKED_SETTINGS=               # keys the admin page must show read-only
