{
  "name": "send2ereader",
  "version": "2.0.0",
  "description": "Send ebooks to Kobo/Kindle ereaders easily",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scan:secrets": "node scripts/scan-for-credentials.mjs --all",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "author": "devnullv0id",
  "contributors": [
    "djazz (original send2ereader)"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^10.1.2",
    "@simplewebauthn/server": "^13.3.2",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "file-type": "^22.0.1",
    "nodemailer": "^9.0.4",
    "openid-client": "^6.8.4",
    "pino": "^10.3.1",
    "sanitize-filename": "^1.6.4",
    "transliteration": "^2.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
