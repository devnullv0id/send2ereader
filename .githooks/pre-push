#!/bin/sh
# The commit hook is not enough: the leak that prompted this was committed one
# day and pushed another, by which time the working tree was clean and only the
# history still held it. So every push is checked over the whole range it sends,
# not over the tip.
set -eu

root="$(git rev-parse --show-toplevel)"
remote_head="${2:-}"
status=0

while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # A new branch or tag: everything it carries that the remote lacks.
        range="$local_sha --not --remotes=${remote_head:-origin}"
    else
        range="${remote_sha}..${local_sha}"
    fi

    printf 'checking %s for credentials\n' "${remote_ref:-$local_sha}" >&2
    # shellcheck disable=SC2086
    node "$root/scripts/scan-for-credentials.mjs" --range $range || status=1
done

exit "$status"
